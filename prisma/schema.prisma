// Esquema de datos de Qubi.
// Docs: https://pris.ly/d/prisma-schema
// La URL de conexión se configura en prisma.config.ts (lee DATABASE_URL del .env).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum PageType {
  PAGE
  DATABASE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// Qué hace el cronómetro mientras la persona está documentando un avance
// (escribiendo la nota y adjuntando evidencia). Lo decide el manager al crear
// el proyecto y se puede afinar tarea por tarea.
enum ProgressTimerPolicy {
  PAUSE // se pausa: documentar no suma tiempo
  HALF // sigue corriendo, pero cuenta la mitad del tiempo
}

// Prioridad de una tarea.
enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Estado de una invitación a un espacio de trabajo.
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Tipo de notificación que recibe un usuario.
enum NotificationType {
  TASK_ASSIGNED // te asignaron como responsable de una tarea
  TASK_DUE_SOON // una tarea tuya está por vencer
  TASK_REVIEW_FEEDBACK // el manager comentó/dio feedback sobre tus avances
  TASK_REOPENED // el manager devolvió tu tarea a pendiente o en curso
  MENTIONED // te mencionaron con @ en un comentario o mensaje de chat
}

// Tipo de tarea (para clasificar y filtrar el trabajo).
enum IssueType {
  TASK
  FEATURE
  BUG
  IMPROVEMENT
  DOCS
}

// Tipo de comentario dentro de una tarea.
enum IssueCommentKind {
  COMMENT // conversación normal
  PROGRESS // avance documentado mientras la tarea está en curso
  REVIEW_FEEDBACK // feedback del manager sobre los avances
}

// ── Usuarios ─────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  image          String?
  hashedPassword String? // login con email/contraseña (Fase 1)
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships       WorkspaceMember[]
  ownedWorkspaces   Workspace[]               @relation("WorkspaceOwner")
  createdPages      Page[]                    @relation("PageCreatedBy")
  accounts          Account[]
  sessions          Session[]
  favorites         Favorite[]
  authoredIssues    Issue[]                   @relation("IssueAuthor")
  issueAssignments  IssueAssignee[]
  issueComments     IssueComment[]            @relation("IssueCommentAuthor")
  issueAttachments  IssueAttachment[]         @relation("IssueAttachmentUploader")
  issueStatusEvents IssueStatusEvent[]        @relation("IssueStatusEventActor")
  timeEntries       TimeEntry[]
  notifications     Notification[]            @relation("NotificationRecipient")
  triggeredNotifs   Notification[]            @relation("NotificationActor")
  sentInvites       WorkspaceInvite[]         @relation("InviteCreatedBy")
  runningTimer      RunningTimer?
  workSessions      WorkSession[]
  conversations     ConversationParticipant[]
  chatMessages      ChatMessage[]             @relation("ChatMessageSender")
  commentReactions  IssueCommentReaction[]
  chatReactions     ChatMessageReaction[]
}

// ── Auth.js (NextAuth) ───────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Workspaces (espacios de trabajo) ─────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  pages         Page[]
  issues        Issue[]
  projects      Project[]
  labels        Label[]
  invites       WorkspaceInvite[]
  notifications Notification[]
  workSessions  WorkSession[]
  conversations Conversation[]

  @@index([ownerId])
}

// ── Proyectos (agrupan tareas y horas de trabajo) ────────────────────────
model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String        @default("")
  color       String? // color para la UI (hex)
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Política por defecto del cronómetro al documentar avances en este
  // proyecto; cada tarea puede sobrescribirla (Issue.progressTimerPolicy).
  progressTimerPolicy ProgressTimerPolicy @default(PAUSE)

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks         Issue[] // las tareas del proyecto (modelo Issue)
  timeEntries   TimeEntry[]
  runningTimers RunningTimer[]
  workSessions  WorkSession[]
  databases     ProjectDatabase[] // bases de datos de archivos vinculadas (pueden compartirse entre proyectos)
  conversation  Conversation? // canal de chat grupal del proyecto

  @@index([workspaceId])
}

// Tabla puente proyecto <-> base de datos de archivos (Page con type=DATABASE).
// Una misma base de datos puede vincularse a 2 o más proyectos.
model ProjectDatabase {
  id        String   @id @default(cuid())
  projectId String
  pageId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([projectId, pageId])
  @@index([pageId])
}

// Tabla puente usuario <-> workspace (con su rol).
model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  // Jornada de esta persona en el equipo, en minutos por semana (media
  // jornada, contratos distintos…). null = la capacidad por defecto.
  weeklyCapacityMinutes Int?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// Invitación a un espacio. La persona invitada debe aceptarla para entrar
// (antes se la añadía directamente). Se identifica por email para poder invitar
// a quien aún no tiene cuenta: la invitación aparece cuando inicia sesión.
model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String // correo de la persona invitada (normalizado en minúsculas)
  role        WorkspaceRole @default(MEMBER)
  status      InviteStatus  @default(PENDING)
  invitedById String? // quién envió la invitación
  createdAt   DateTime      @default(now())
  respondedAt DateTime? // cuándo se aceptó o rechazó

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InviteCreatedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
}

// Notificación dirigida a un usuario (asignación de tarea, vencimiento, etc.).
// El texto se guarda denormalizado para que sobreviva si la tarea cambia o se
// borra. `issueId` no tiene clave foránea a propósito (acoplamiento débil).
model Notification {
  id          String           @id @default(cuid())
  userId      String // destinatario
  type        NotificationType
  title       String // texto principal ya formateado
  body        String           @default("") // detalle (p. ej. el título de la tarea)
  href        String? // a dónde lleva al hacer clic
  workspaceId String?
  issueId     String? // tarea relacionada (sin FK, para deduplicar)
  actorId     String? // quién la provocó
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user      User       @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, issueId])
}

// ── Páginas (contenido; anidables en árbol) ──────────────────────────────

model Page {
  id          String    @id @default(cuid())
  workspaceId String
  parentId    String? // null = página de primer nivel
  databaseId  String? // si está, esta página es una FILA de esa base de datos
  title       String    @default("")
  icon        String?
  cover       String?
  type        PageType  @default(PAGE)
  content     Json? // documento de bloques (JSON; legado pre-Yjs)
  yjsState    Bytes? // documento Yjs (binario) para edición colaborativa en tiempo real
  isPublic    Boolean   @default(false) // enlace público de solo lectura
  archivedAt  DateTime? // papelera (soft-delete)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Page?     @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]    @relation("PageTree")
  createdBy User?     @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Bases de datos tipo Notion
  database           Page?              @relation("DatabaseRows", fields: [databaseId], references: [id], onDelete: Cascade)
  rows               Page[]             @relation("DatabaseRows")
  databaseProperties DatabaseProperty[] @relation("DatabaseProperties")
  propertyValues     PropertyValue[]    @relation("RowValues")
  favoritedBy        Favorite[]
  linkedByIssues     Issue[]            @relation("IssueLinkedPage")
  projectDatabases   ProjectDatabase[] // proyectos que usan esta página como base de datos de archivos

  @@index([workspaceId])
  @@index([parentId])
  @@index([databaseId])
}

// Página marcada como favorita por un usuario.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([userId])
}

// ── Issues (seguimiento estilo GitHub) ───────────────────────────────────────

enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Tarea / pendiente. Pertenece a un workspace y (opcionalmente) a un proyecto.
model Issue {
  id           String      @id @default(cuid())
  workspaceId  String
  projectId    String? // proyecto al que pertenece (null = sin clasificar)
  number       Int // secuencial por espacio (#1, #2, …)
  title        String
  body         String      @default("")
  type         IssueType   @default(TASK)
  status       IssueStatus @default(TODO)
  priority     Priority    @default(MEDIUM)
  startDate    DateTime? // fecha de inicio planificada (alimenta el Gantt)
  dueDate      DateTime? // fecha límite (alimenta la agenda y el calendario)
  completedAt  DateTime? // momento en que se marcó como HECHA
  authorId     String?
  linkedPageId String? // ruta vinculada dentro de la base de datos de archivos del proyecto
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // null = hereda la política del proyecto (Project.progressTimerPolicy).
  progressTimerPolicy ProgressTimerPolicy?

  // Esfuerzo estimado en minutos. Es lo que permite pintar la carga PREVISTA
  // en la vista de equipo: se reparte entre los días de trabajo de la tarea.
  estimateMinutes Int?

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        User?              @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  linkedPage    Page?              @relation("IssueLinkedPage", fields: [linkedPageId], references: [id], onDelete: SetNull)
  assignees     IssueAssignee[]
  labels        IssueLabel[]
  comments      IssueComment[]
  attachments   IssueAttachment[]
  statusEvents  IssueStatusEvent[]
  timeEntries   TimeEntry[]
  workSessions  WorkSession[]
  runningTimers RunningTimer[]

  @@unique([workspaceId, number])
  @@index([workspaceId])
  @@index([projectId])
  @@index([linkedPageId])
}

// Tabla puente tarea <-> asignado. Una tarea admite hasta 3 (validado en la app).
model IssueAssignee {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

// Etiqueta reutilizable dentro de un workspace (nombre + color).
model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String // hex para la UI
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// Tabla puente tarea <-> etiqueta.
model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([labelId])
}

// Archivo adjunto a la tarea (independiente de los comentarios): fotos,
// documentos, capturas. Queda visible aunque la tarea ya esté Hecha.
model IssueAttachment {
  id           String   @id @default(cuid())
  issueId      String
  commentId    String? // si vino adjunto en un avance/comentario, para poder mostrarlo dentro
  url          String
  name         String
  mimeType     String
  size         Int // bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  issue      Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment    IssueComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation("IssueAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([commentId])
}

// Historial de cambios de estado de una tarea: quién movió qué a qué estado
// y cuándo (incluye reaperturas del manager). Queda para siempre.
model IssueStatusEvent {
  id         String       @id @default(cuid())
  issueId    String
  fromStatus IssueStatus?
  toStatus   IssueStatus
  actorId    String?
  note       String       @default("")
  createdAt  DateTime     @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation("IssueStatusEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
}

// Registro de horas de trabajo de un usuario en un proyecto, por día.
model TimeEntry {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  issueId   String? // opcional: horas imputadas a una tarea concreta
  date      DateTime @db.Date // el día trabajado (sin hora)
  minutes   Int // duración en minutos (1 h 30 min = 90)
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([userId, date])
  @@index([issueId])
}

// Temporizador en marcha de un usuario (un único cronómetro activo por persona).
// Al detenerlo se calcula el tiempo transcurrido y se suma a las horas del día.
// accumulatedMinutes guarda lo ya corrido antes de la pausa actual; mientras
// pausedAt sea null, el tiempo sigue corriendo desde startedAt.
model RunningTimer {
  id                 String    @id @default(cuid())
  userId             String    @unique // un solo temporizador activo por usuario
  projectId          String
  issueId            String // tarea que se está trabajando (obligatoria)
  sessionId          String    @unique
  startedAt          DateTime  @default(now())
  accumulatedMinutes Int       @default(0)
  pausedAt           DateTime?

  // Mientras se documenta un avance el tiempo no corre normal: según la
  // política (PAUSE / HALF) no suma o suma la mitad. progressStartedAt marca
  // desde cuándo está en ese modo (null = trabajando normal).
  progressStartedAt DateTime?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  session WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([issueId])
}

// Historial de sesiones de trabajo (cada vez que se inicia el cronómetro).
// Queda un registro aunque el RunningTimer ya se haya cerrado/borrado.
model WorkSession {
  id          String    @id @default(cuid())
  userId      String
  projectId   String
  workspaceId String
  issueId     String? // tarea en la que se trabajó (las sesiones nuevas siempre la llevan)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  minutes     Int       @default(0)

  // Sesión demasiado corta (< MIN_BILLABLE_MINUTES): se conserva junto con sus
  // avances, pero no se imputa a las horas del día.
  discarded Boolean @default(false)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue        Issue?            @relation(fields: [issueId], references: [id], onDelete: SetNull)
  notes        WorkSessionNote[]
  runningTimer RunningTimer?

  @@index([userId, startedAt])
  @@index([workspaceId, startedAt])
  @@index([projectId])
  @@index([issueId])
}

// Avance registrado durante una sesión de trabajo (nota + captura opcional).
model WorkSessionNote {
  id            String   @id @default(cuid())
  sessionId     String
  body          String
  screenshotUrl String?
  createdAt     DateTime @default(now())

  // El mismo avance vive como comentario (kind PROGRESS) en la tarea: aquí solo
  // se guarda el enlace para que la pestaña "Avances" lleve al detalle.
  issueCommentId String? @unique

  session      WorkSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  issueComment IssueComment? @relation(fields: [issueCommentId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model IssueComment {
  id            String           @id @default(cuid())
  issueId       String
  authorId      String?
  kind          IssueCommentKind @default(COMMENT)
  body          String
  attachmentUrl String?
  createdAt     DateTime         @default(now())

  issue       Issue                  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author      User?                  @relation("IssueCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reactions   IssueCommentReaction[]
  attachments IssueAttachment[] // archivos subidos junto a este avance/comentario
  sessionNote WorkSessionNote? // avance creado desde el cronómetro

  @@index([issueId])
}

// Reacción tipo emoji a un comentario de tarea. Un usuario puede reaccionar
// con varios emojis distintos al mismo comentario, pero no repetir el mismo.
model IssueCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment IssueComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

enum PropertyType {
  TEXT
  NUMBER
  SELECT
  DATE
  CHECKBOX
}

// Columna de una base de datos (la base de datos es una Page con type=DATABASE).
model DatabaseProperty {
  id         String       @id @default(cuid())
  databaseId String
  name       String
  type       PropertyType @default(TEXT)
  position   Int          @default(0)
  config     Json? // opciones de SELECT, formato, etc.
  createdAt  DateTime     @default(now())

  database Page            @relation("DatabaseProperties", fields: [databaseId], references: [id], onDelete: Cascade)
  values   PropertyValue[]

  @@index([databaseId])
}

// Valor de una propiedad para una fila concreta.
model PropertyValue {
  id         String @id @default(cuid())
  pageId     String // la fila (Page)
  propertyId String
  value      Json?

  page     Page             @relation("RowValues", fields: [pageId], references: [id], onDelete: Cascade)
  property DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([pageId, propertyId])
  @@index([pageId])
}

// ── Chat entre usuarios ──────────────────────────────────────────────────
// DIRECT: 1 a 1, el par de participantes es único (se busca/crea en el
// servicio antes de insertar). GROUP: un canal por proyecto (projectId
// único), donde participan quienes lo visitan (se unen al entrar).
enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id          String           @id @default(cuid())
  workspaceId String
  type        ConversationType @default(DIRECT)
  name        String? // solo GROUP: nombre del canal (ej. nombre del proyecto)
  projectId   String? // solo GROUP: proyecto al que pertenece el canal
  createdAt   DateTime         @default(now())

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@unique([projectId])
  @@index([workspaceId])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String?
  body           String   @default("")
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  conversation Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?                 @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  reactions    ChatMessageReaction[]

  @@index([conversationId, createdAt])
}

model ChatMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
